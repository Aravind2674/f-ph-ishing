# ThreatFusion Configuration
# Copy this file to .env and fill in your API keys

# Set to 'false' when you have real API keys
USE_MOCK_DATA=true

# VirusTotal API key (free tier: 4 requests/min)
VIRUSTOTAL_API_KEY=PASTE_YOUR_VIRUSTOTAL_KEY_HERE

# Shodan API key (optional — InternetDB is free, full API needs a key)
SHODAN_API_KEY=PASTE_YOUR_SHODAN_KEY_HERE

# NVD API key (optional — unauthenticated works but is rate-limited)
NVD_API_KEY=PASTE_YOUR_NVD_KEY_HERE

# Database
DATABASE_URL=sqlite:///./threatfusion.db

# Logging
LOG_LEVEL=INFO
