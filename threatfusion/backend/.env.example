# ThreatFusion Configuration
# Copy this file to .env and fill in your API keys

# Set to 'false' when you have real API keys
USE_MOCK_DATA=true

# VirusTotal API key (free tier: 4 requests/min, 500/day)
VIRUSTOTAL_API_KEY=PASTE_YOUR_VIRUSTOTAL_KEY_HERE
# Quota enforced by ONE limiter shared by scans and the network layer (set both to 0 for a premium key),
# how long a scan queues for a slot before reporting "rate limited", and how long an answer is cached.
VIRUSTOTAL_REQUESTS_PER_MINUTE=4
VIRUSTOTAL_REQUESTS_PER_DAY=500
VIRUSTOTAL_MAX_QUEUE_SECONDS=15
VIRUSTOTAL_CACHE_TTL_SECONDS=21600

# Shodan API key (optional — InternetDB is free, full API needs a key)
SHODAN_API_KEY=PASTE_YOUR_SHODAN_KEY_HERE

# NVD API key. Without a real key CVE enrichment is SKIPPED (reported as "not configured").
# Placeholder values like PASTE_YOUR_* are treated as unset and are never sent to a provider.
NVD_API_KEY=PASTE_YOUR_NVD_KEY_HERE
# NVD's published limit with a key: 50 requests per rolling 30 s. 403/429/503 are retried with backoff; one scan
# gets NVD_DEADLINE_SECONDS (lookups that finished are kept); CVE records are cached for NVD_CACHE_TTL_SECONDS.
NVD_REQUESTS_PER_WINDOW=50
NVD_WINDOW_SECONDS=30
NVD_MAX_CONCURRENCY=5
NVD_DEADLINE_SECONDS=15
NVD_LOOKUP_BY_CPE=true

# ── Host signals (keyless; each can be switched off) ───────────────────
# TLS: connects to <host>:443 and reads the certificate. RDAP: asks the TLD registry's public RDAP service about the
# REGISTERED DOMAIN (WHOIS only where a TLD has no RDAP). DNS: A/AAAA/MX/NS/TXT/CAA/DMARC + hosting ASN. None of them
# is ever given a full URL or a private/local name.
TLS_ENABLED=true
RDAP_ENABLED=true
RDAP_WHOIS_FALLBACK=true
DNS_ENABLED=true
# Certificate transparency (B3): crt.sh, asked about the host name only (first certificate, recent issuance, issuer)
CT_ENABLED=true
CT_REQUESTS_PER_MINUTE=10

# ── Independent reputation channels (B2) ───────────────────────────────
# Each answers "is this target known bad?" without VirusTotal. A channel whose key is unset is reported "not configured"
# (a gap in the evidence, never a clean result). Placeholders like PASTE_YOUR_* count as unset. Only host names, resolved
# public IPs, hashes and the privacy-trimmed URL are sent; keys travel in headers.
ABUSECH_AUTH_KEY=PASTE_YOUR_ABUSECH_AUTH_KEY_HERE            # URLhaus + ThreatFox (free)
GOOGLE_SAFE_BROWSING_API_KEY=PASTE_YOUR_SAFE_BROWSING_KEY_HERE # non-commercial use only; commercial use = Web Risk
ABUSEIPDB_API_KEY=PASTE_YOUR_ABUSEIPDB_KEY_HERE
OTX_API_KEY=PASTE_YOUR_OTX_KEY_HERE
# Optional (work keyless at lower limits): URLSCAN_API_KEY, GREYNOISE_API_KEY, PHISHTANK_APP_KEY
# Local lists are downloaded once and refreshed on a schedule; every answer shows the list's age.
OPENPHISH_ENABLED=true
PHISHTANK_ENABLED=true
TRANCO_ENABLED=true
# ABUSEIPDB_MIN_CONFIDENCE=50      # abuse-confidence score at or above which an IP counts as listed

# ── Brand impersonation (B4): a local check, no network ────────────────
LOOKALIKE_ENABLED=true
LOOKALIKE_THRESHOLD=0.80
# Optional resolvers for DNS (comma-separated IPs); empty = the system resolver
DNS_NAMESERVERS=

# ── Exploit exposure (keyless) ─────────────────────────────────────────
# EPSS (FIRST.org) predicts exploitation; CISA KEV confirms it (downloaded once a day and kept locally, so lookups are
# free and every answer shows the feed's age); CISA Vulnrichment adds SSVC decision points. Only CVE ids are sent out.
EPSS_ENABLED=true
KEV_ENABLED=true
KEV_MAX_AGE_HOURS=24
VULNRICHMENT_ENABLED=true
EXPOSURE_MAX_CVES=50

# ── Network Layer ──────────────────────────────────────────────────────
# WiGLE uses an API name + token (Basic auth), not a single key.
# Register at https://wigle.net/ then copy both from your account page.
# Leave blank to run the AP scorer in honest-degrade mode (no WiGLE signal).
WIGLE_API_NAME=
WIGLE_API_TOKEN=

# Capture interfaces (passed to scapy). Empty = scapy default.
#   List available names on Windows with:  python -c "from scapy.all import get_windows_if_list as g; [print(i['name']) for i in g()]"
NETWORK_CAPTURE_INTERFACE=
# 802.11 monitor-mode interface for deauth detection (requires a
# monitor-capable adapter + Npcap in monitor mode). Empty disables it.
NETWORK_MONITOR_INTERFACE=
# Optional: your gateway/router IP — emphasises ARP spoofing against it.
NETWORK_GATEWAY_IP=
# SSIDs you own (comma-separated). A new BSSID advertising one of these
# names is treated as a probable evil-twin.
NETWORK_MONITORED_SSIDS=
# Start capturing automatically when the API boots (needs Npcap + admin).
NETWORK_AUTO_START=false

# Database
DATABASE_URL=sqlite:///./threatfusion.db

# Logging
LOG_LEVEL=INFO

# ── Active verification (POST /verify) ─────────────────────────────────
# Sends probe requests (XSS canary, SQLi checks) to a target. OFF unless you enable it, and the
# scope is decided HERE — a caller can never authorise itself (the request's `authorized_hosts`
# field is ignored). Entries: host or host:port, comma-separated. Listed hosts may be private/lab
# addresses, but never link-local / cloud-metadata space. Every call is written to the
# append-only `verify_audit` table.
VERIFY_ENABLED=false
VERIFY_ALLOWED_HOSTS=127.0.0.1:8099,localhost:8099
VERIFY_RATE_PER_MINUTE=6
VERIFY_TLS=true

# Ports the SSRF-safe fetcher may connect to for user-supplied targets ("*" = any, not advised)
SAFE_FETCH_PORTS=80,443,8080,8443

# Model directory (default: <threatfusion>/ml/models, independent of the working directory)
# MODEL_DIR=
# Refuse model files that are not in ml/models/manifest.json (SHA-256)
MODEL_HASH_STRICT=true

# ── API access control ─────────────────────────────────────────────────
# Every route except /health requires `Authorization: Bearer <token>`. If API_TOKEN is empty a random
# token is generated on first start and stored OUTSIDE the repo (Windows: %APPDATA%\ThreatFusion\api_token,
# else ~/.config/threatfusion/api_token). Print it with:  python -m app.core.auth
API_TOKEN=
API_TOKEN_FILE=
# Host headers the API answers to (port ignored); anything else is refused (anti-DNS-rebinding).
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ── Resource limits ────────────────────────────────────────────────────
# Per-client cap on POST /scan per minute (0 = off). Provider-specific quotas are handled by the clients.
RATE_LIMIT_REQUESTS_PER_MINUTE=30
# Any request body above this gets HTTP 413
MAX_REQUEST_BODY_BYTES=10485760
# Requests (+ HAR entries) accepted per /traffic/analyze call (HTTP 413 above this)
MAX_TRAFFIC_REQUESTS=500
# Time budget for one scan's provider lookups, and the cap for a single lookup (slow ones become error/timeout)
SCAN_DEADLINE_SECONDS=45
PROVIDER_TIMEOUT_SECONDS=20

# ── Privacy / retention ────────────────────────────────────────────────
# Network monitoring stores which domains each device asked for. Rows older than this many days are
# deleted automatically (0 = keep forever). DELETE /network/data erases everything on demand.
NETWORK_RETENTION_DAYS=30
